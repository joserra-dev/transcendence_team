# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Frontend
FRONT_PORT=4200
URL_FRONT=https://localhost:4200

# Backend
BACK_PORT=8000
URL_BACK=https://localhost:8000

# PostgreSQL
POSTGRES_DB=defaultdb
POSTGRES_USER=defaultdb_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://defaultdb_user:change_me@db:5432/defaultdb

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# JWT (OBLIGATORIO) - genera uno con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_secret
# Expiración del token de acceso en minutos (por defecto 120 = 2 horas)
JWT_ACCESS_TOKEN_EXPIRES=120

# Public API (OBLIGATORIO) - genera uno con: python3 -c "import secrets; print(secrets.token_hex(32))"
PUBLIC_API_KEY=change_this_public_api_key
PUBLIC_API_RATE_LIMIT=60
# Rate limiting storage (Flask-Limiter). Usa Redis en producción; "memory://" para dev local.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

STRIPE_KEY=sk_test_your_stripe_key

SUPER_ADMIN_PASSWORD=admin and superadmins pass
