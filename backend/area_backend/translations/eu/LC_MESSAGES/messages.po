#: routes/booking_routes.py:66 routes/booking_routes.py:245
#: routes/booking_routes.py:271 routes/booking_routes.py:295
msgid "Reserva no encontrada"
msgstr "Erreserba ez da aurkitu"

#: routes/booking_routes.py:69 routes/booking_routes.py:85
msgid "No tienes permiso para ver esta reserva"
msgstr "Ez duzu baimenik erreserba hau ikusteko"

#: routes/booking_routes.py:161 routes/booking_routes.py:267
msgid "Faltan campos obligatorios"
msgstr "Nahitaezko eremuak falta dira"

#: routes/booking_routes.py:164
msgid "La matrícula del vehículo es obligatoria"
msgstr "Ibilgailuaren matrikula nahitaezkoa da"

#: routes/booking_routes.py:170
msgid "Formato de fecha inválido"
msgstr "Data-formatu baliogabea"

#: routes/booking_routes.py:173
msgid ""
"La fecha de salida debe ser al menos un día después de la fecha de "
"entrada."
msgstr "Irteera-datak sarrera-data baino gutxienez egun bat beranduago izan behar du."

#: routes/booking_routes.py:186
msgid ""
"Ya existe una reserva para esta matrícula en las fechas seleccionadas. "
"Usa otra matrícula o cambia las fechas."
msgstr ""
"Dagoeneko badago erreserba bat matrikula honentzat hautatutako datetan. "
"Mesedez, erabili beste matrikula bat edo aldatu datak."

#: routes/booking_routes.py:237 routes/booking_routes.py:261
#: routes/booking_routes.py:287 routes/users_routes.py:267
msgid "Petición inválida"
msgstr "Eskaera baliogabea"

#: routes/booking_routes.py:241 routes/booking_routes.py:291
msgid "Falta idReserva"
msgstr "idReserva falta da"

#: routes/booking_routes.py:249
msgid "No tienes permiso para cancelar esta reserva"
msgstr "Ez duzu baimenik erreserba hau bertan behera uzteko"

#: routes/booking_routes.py:254
msgid "Reserva cancelada correctamente"
msgstr "Erreserba modu egokian bertan behera utzi da"

#: routes/booking_routes.py:275
msgid "No tienes permiso para puntuar esta reserva"
msgstr "Ez duzu baimenik erreserba hau puntuatzeko"

#: routes/booking_routes.py:280
msgid "Puntuación guardada correctamente"
msgstr "Puntuazioa modu egokian gorde da"

#: routes/booking_routes.py:299
msgid "No tienes permiso para ver el QR de esta reserva"
msgstr "Ez duzu baimenik erreserba honen QR kodea ikusteko"

#: routes/parking_routes.py:118
msgid "Parking no encontrado"
msgstr "Aparkalekua ez da aurkitu"

#: routes/space_routes.py:33
msgid "Plaza no existe"
msgstr "Plaza ez da existitzen"

#: routes/users_routes.py:130 routes/users_routes.py:248
#: routes/users_routes.py:263 routes/users_routes.py:440
msgid "Usuario no encontrado"
msgstr "Erabiltzailea ez da aurkitu"

#: routes/users_routes.py:181
msgid "Todos los campos son obligatorios (email, password, confirmPassword)"
msgstr "Eremu guztiak nahitaezkoak dira (email, password, confirmPassword)"

#: routes/users_routes.py:184 routes/users_routes.py:559
msgid "Las contraseñas introducidas no coinciden"
msgstr "Sartutako pasahitzak ez datoz bat"

#: routes/users_routes.py:192
msgid "Este email ya está registrado"
msgstr "E-posta hau dagoeneko erregistratuta dago"

#: routes/users_routes.py:206
msgid "Error al registrar el usuario"
msgstr "Errorea erabiltzailea erregistratzean"

#: routes/users_routes.py:211
msgid "Usuario registrado con éxito"
msgstr "Erabiltzailea ongi erregistratu da"

#: routes/users_routes.py:216
msgid "Error al enviar el mail de bienvenida"
msgstr "Errorea ongi etorri e-posta bidaltzean"

#: routes/users_routes.py:253
msgid "Error al obtener los datos del usuario"
msgstr "Errorea erabiltzailearen datuak lortzean"

#: routes/users_routes.py:303
msgid "Perfil actualizado correctamente"
msgstr "Profila modu egokian eguneratu da"

#: routes/users_routes.py:354 routes/users_routes.py:390
msgid "Todos los campos son obligatorios (email, password)"
msgstr "Eremu guztiak nahitaezkoak dira (email, password)"

#: routes/users_routes.py:360 routes/users_routes.py:364
#: routes/users_routes.py:394 routes/users_routes.py:397
msgid "Credenciales incorrectas"
msgstr "Kredentzial okerrak"

#: routes/users_routes.py:368 routes/users_routes.py:400
msgid "Debes verificar tu correo electrónico antes de iniciar sesión"
msgstr "Saioa hasi baino lehen zure e-posta egiaztatu behar duzu"

#: routes/users_routes.py:372
msgid "Debes iniciar sesión desde el acceso de administrador"
msgstr "Administratzailearen sarbidetik hasi behar duzu saioa"

#: routes/users_routes.py:377 routes/users_routes.py:408
msgid "¡Login exitoso!"
msgstr "Saio-hasiera arrakastatsua!"

#: routes/users_routes.py:404
msgid "No tienes permisos de administrador"
msgstr "Ez duzu administratzaile baimenik"

#: routes/users_routes.py:491
msgid "El campo email es obligatorio"
msgstr "E-posta eremua nahitaezkoa da"

#: routes/users_routes.py:506 routes/users_routes.py:519
#: routes/users_routes.py:572
msgid "Error interno al procesar la solicitud"
msgstr "Barne errorea eskaera prozesatzean"

#: routes/users_routes.py:521
msgid "Si el correo existe, se enviarán las instrucciones."
msgstr "E-posta existitzen bada, argibideak bidaliko dira."

#: routes/users_routes.py:556
msgid "token, password y confirmPassword son obligatorios"
msgstr "token, password eta confirmPassword nahitaezkoak dira"

#: routes/users_routes.py:563
msgid "El enlace de recuperación no es válido o ha caducado"
msgstr "Berreskuratzeko esteka ez da baliozkoa edo iraungi egin da"

#: routes/users_routes.py:570
msgid "Contraseña actualizada correctamente"
msgstr "Pasahitza modu egokian eguneratu da"

#: routes/users_routes.py:604
msgid "Falta el token de verificación."
msgstr "Egiaztapen-tokena falta da."

#: routes/users_routes.py:612
msgid "El token no es válido o ya ha sido utilizado."
msgstr "Tokena ez da baliozkoa edo dagoeneko erabili da."

#: routes/users_routes.py:622
msgid "¡Cuenta verificada con éxito! Ya puedes iniciar sesión."
msgstr "Kontua ongi egiaztatu da! Saioa has dezakezu orain."

#: utils/password_validator.py:18
msgid "La contraseña no puede estar vacía."
msgstr "Pasahitza ezin da hutsik egon."

#: utils/password_validator.py:25
msgid "La contraseña no puede contener la palabra 'password'."
msgstr "Pasahitzak ezin du 'password' hitza eduki."

#: utils/password_validator.py:34
msgid "La contraseña no puede contener partes de tu correo electrónico."
msgstr "Pasahitzak ezin du zure e-posta helbidearen zatirik eduki."

#: utils/password_validator.py:38
msgid "La contraseña debe tener al menos 8 caracteres."
msgstr "Pasahitzak gutxienez 8 karaktere izan behar ditu."

#: utils/password_validator.py:41
msgid "La contraseña debe contener al menos una letra mayúscula."
msgstr "Pasahitzak gutxienez letra maiuskula bat izan behar du."

#: utils/password_validator.py:44
msgid "La contraseña debe contener al menos una letra minúscula."
msgstr "Pasahitzak gutxienez letra minuskula bat izan behar du."

#: utils/password_validator.py:47
msgid "La contraseña debe contener al menos un número."
msgstr "Pasahitzak gutxienez zenbaki bat izan behar du."

#: utils/password_validator.py:50
msgid "La contraseña debe contener al menos un carácter especial (@$!%*?&)."
msgstr "Pasahitzak gutxienez karaktere berezi bat izan behar du (@$!%*?&)."

#: utils/password_validator.py:54
msgid "La contraseña no cumple con el formato de seguridad requerido."
msgstr "Pasahitzak ez du eskatutako segurtasun-formatua betetzen."

#: utils/password_validator.py:56
msgid "Contraseña válida."
msgstr "Pasahitz baliozkoa."