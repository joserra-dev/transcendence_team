msgstr "HEMEN-GO - Recover account access"

#: services/email_services.py:113
#, python-format
msgid ""
"Hola %(user_name)s,\n\n"
"Hemos recibido una solicitud para restablecer tu contraseña en HEMEN-GO.\n"
"Abre este enlace para crear una nueva contraseña:\n%(recovery_url)s\n\n"
"El enlace caduca en 1 hora.\n"
"Si no solicitaste este cambio, ignora este correo."
msgstr ""
"Hello %(user_name)s,\n\n"
"We received a request to reset your password for your HEMEN-GO account.\n"
"Open this link to create a new password:\n%(recovery_url)s\n\n"
"The link will expire in 1 hour.\n"
"If you did not request this change, please ignore this email."

#: utils/password_validator.py:18
msgid "La contraseña no puede estar vacía."
msgstr "Password cannot be empty."

#: utils/password_validator.py:25
msgid "La contraseña no puede contener la palabra 'password'."
msgstr "Password cannot contain the word 'password'."

#: utils/password_validator.py:34
msgid "La contraseña no puede contener partes de tu correo electrónico."
msgstr "Password cannot contain parts of your email address."

#: utils/password_validator.py:38
msgid "La contraseña debe tener al menos 8 caracteres."
msgstr "Password must be at least 8 characters long."

#: utils/password_validator.py:41
msgid "La contraseña debe contener al menos una letra mayúscula."
msgstr "Password must contain at least one uppercase letter."

#: utils/password_validator.py:44
msgid "La contraseña debe contener al menos una letra minúscula."
msgstr "Password must contain at least one lowercase letter."

#: utils/password_validator.py:47
msgid "La contraseña debe contener al menos un número."
msgstr "Password must contain at least one number."

#: utils/password_validator.py:50
msgid "La contraseña debe contener al menos un carácter especial (@$!%*?&)."
msgstr "Password must contain at least one special character (@$!%*?&)."

#: utils/password_validator.py:54
msgid "La contraseña no cumple con el formato de seguridad requerido."
msgstr "Password does not meet the required security format."

#: utils/password_validator.py:56
msgid "Contraseña válida."
msgstr "Valid password."

